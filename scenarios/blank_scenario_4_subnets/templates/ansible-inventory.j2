all:
  children:
    range42_infrastructure:
      children:
        ####

        r42_admin:
          hosts:
            r42.bs4-admin-wazuh:
            r42.bs4-admin-misp:
            r42.bs4-admin-gitea:
            r42.bs4-admin-mattermost:
            r42.bs4-admin-nextcloud:
            r42.bs4-admin-rocketchat:
            r42.bs4-admin-deployer-api-gateway:
            r42.bs4-admin-deployer-api-backend:
            r42.bs4-admin-deployer-ui:

        ####

        r42_blank_group:
          hosts:
            r42.bs4-team-143-01:
            r42.bs4-team-143-02:
            r42.bs4-team-143-03:
            r42.bs4-team-143-04:
            r42.bs4-team-144-01:
            r42.bs4-team-144-02:
            r42.bs4-team-144-03:
            r42.bs4-team-144-04:
            r42.bs4-team-145-01:
            r42.bs4-team-145-02:
            r42.bs4-team-145-03:
            r42.bs4-team-145-04:
            r42.bs4-team-146-01:
            r42.bs4-team-146-02:
            r42.bs4-team-146-03:
            r42.bs4-team-146-04:

        ####

        # All potential wazuh-agent clients (every non-server VM in the scenario).
        # This static group is the POTENTIAL set. At deploy time, the runtime
        # group r42_blank_scenario_4_subnets_wazuh_clients_active is built by
        # _build_wazuh_clients_active_group.yml based on INSTALL_<flag> values
        # (admin-misp is added only when INSTALL_MISP=YES). The wazuh-agent
        # finalize play targets the runtime active group, not this static set.
        r42_blank_scenario_4_subnets_wazuh_clients:
          hosts:
            r42.bs4-admin-misp:
            r42.bs4-admin-gitea:
            r42.bs4-admin-mattermost:
            r42.bs4-admin-nextcloud:
            r42.bs4-admin-rocketchat:
            r42.bs4-admin-deployer-api-gateway:
            r42.bs4-admin-deployer-api-backend:
            r42.bs4-admin-deployer-ui:
            r42.bs4-team-143-01:
            r42.bs4-team-143-02:
            r42.bs4-team-143-03:
            r42.bs4-team-143-04:
            r42.bs4-team-144-01:
            r42.bs4-team-144-02:
            r42.bs4-team-144-03:
            r42.bs4-team-144-04:
            r42.bs4-team-145-01:
            r42.bs4-team-145-02:
            r42.bs4-team-145-03:
            r42.bs4-team-145-04:
            r42.bs4-team-146-01:
            r42.bs4-team-146-02:
            r42.bs4-team-146-03:
            r42.bs4-team-146-04:

        ####

        proxmox:
          hosts:
            {{ INFRASTRUCTURE_CODENAME }}:
              ansible_host: {{ INFRASTRUCTURE_PROXMOX_ADDRESS | mandatory }}:8006
              ansible_connection: local
              ansible_python_interpreter: /usr/bin/python3

        proxmox_cli:
          hosts:
            {{ INFRASTRUCTURE_CODENAME }}-cli:
