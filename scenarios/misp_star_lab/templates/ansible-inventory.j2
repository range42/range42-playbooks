all:
  children:
    range42_infrastructure:
      children:
        ####

        r42_admin:
          hosts:
            r42.admin-wazuh:

        ####

        # The MISP star (always deployed). Static POTENTIAL set ; the bundle
        # targets the runtime group r42_misp_star_active built by
        # 03_misp_star_lab_infrastructure/_build_misp_star_active_group.yml.
        r42_misp_star:
          hosts:
            r42.admin-misp-star-hub:
            r42.misp-star-spoke-01:
            r42.misp-star-spoke-02:

        ####

        # All potential wazuh-agent clients (every non-server VM in the scenario).
        # This static group is the POTENTIAL set. At deploy time, the runtime
        # group r42_misp_star_lab_wazuh_clients_active is built by
        # _build_wazuh_clients_active_group.yml (the 3 star VMs are the
        # workload VMs, always added). The wazuh-agent finalize play targets
        # the runtime active group, not this static set.
        r42_misp_star_lab_wazuh_clients:
          hosts:
            r42.admin-misp-star-hub:
            r42.misp-star-spoke-01:
            r42.misp-star-spoke-02:

        ####

        proxmox:
          hosts:
            {{ INFRASTRUCTURE_CODENAME }}:
              ansible_host: {{ INFRASTRUCTURE_PROXMOX_ADDRESS | mandatory }}:8006
              ansible_connection: local
              ansible_python_interpreter: /usr/bin/python3

        proxmox_cli:
          hosts:
            {{ INFRASTRUCTURE_CODENAME }}-cli:
