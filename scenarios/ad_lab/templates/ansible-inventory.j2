all:
  children:
    range42_infrastructure:
      children:
        ####

        # The Windows guests. The connection stays ssh (OpenSSH server baked in the templates) ;
        # the shell is PowerShell, and alice is the account cloudbase-init gives the deployer key to.
        r42_ad_windows:
          vars:
            ansible_shell_type: powershell
            ansible_user: alice
          children:
            r42_ad_dc:
              hosts:
                r42.ad-dc01:
            r42_ad_clients:
              hosts:
                r42.ad-client01:

        ####

        proxmox:
          hosts:
            {{ INFRASTRUCTURE_CODENAME }}:
              ansible_host: {{ INFRASTRUCTURE_PROXMOX_ADDRESS | mandatory }}:8006
              ansible_connection: local
              ansible_python_interpreter: /usr/bin/python3

        proxmox_cli:
          hosts:
            {{ INFRASTRUCTURE_CODENAME }}-cli:
